    <!-- Format Info -->
    <string name="format_info_title">Format Info</string>
    <string name="format_badge_licensed">Licensed</string>
    <string name="format_desc_m4a">AAC — sounds better than MP3 at the same bitrate, though not as efficient as Opus. Native on iOS/Android, more widely supported than Opus.</string>
    <string name="format_badge_open_royalty_free">Open, royalty-free</string>
    <string name="format_desc_opus">Opus — most efficient of the three at low bitrates, beating both AAC and MP3. YouTube\'s default audio codec, but supported by fewer older players than AAC or MP3.</string>
    <string name="format_badge_universal">Universal</string>
    <string name="format_desc_mp3">MP3 — the oldest and least efficient of the three, but plays on more devices than AAC or Opus.</string>
    <string name="format_badge_h264">H.264</string>
    <string name="format_desc_mp4">MP4 — a container with H.264 video. More compatible than WebM, though usually less efficient at the same quality.</string>
    <string name="format_desc_webm">WebM/VP9 — compresses better than MP4\'s stream at the same quality, and is YouTube\'s default for higher resolutions. Less universally supported than MP4.</string>

